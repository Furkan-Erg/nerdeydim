# Copy this to .env on the VPS (next to docker-compose.prod.yml) and fill in real values.
# Used by docker-compose.prod.yml — do not commit the real .env file.

POSTGRES_USER=whib
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=where_have_i_been

# Generate with: npx auth-secret (or) openssl rand -base64 32
AUTH_SECRET=change-me

# Public URL the app is served at (behind your Nginx reverse proxy)
NEXTAUTH_URL=https://your-domain.com

# Host port the app container binds to; point your Nginx reverse proxy at this port
APP_PORT=3000
